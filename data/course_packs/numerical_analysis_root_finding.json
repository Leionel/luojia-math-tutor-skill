{
  "course_id": "numerical_analysis",
  "course_title": "数值分析",
  "unit_title": "非线性方程求根 (Root Finding for Nonlinear Equations)",
  "version": "v1.0",
  "units": [
    {
      "id": "NA_ROOT_FINDING",
      "title": "非线性方程求根问题",
      "type": "definition",
      "content": "求一元连续函数 f(x) 的零点 x* 使得 f(x*)=0。数值求根方法通常从初始近似出发，通过迭代格式逐步逼近精确解。",
      "latex": "f(x^*) = 0",
      "difficulty": 1,
      "teaching_role": "core",
      "keywords": ["非线性方程", "求根", "零点", "迭代逼近"]
    },
    {
      "id": "NA_BISECTION",
      "title": "二分法 (Bisection Method)",
      "type": "algorithm",
      "content": "基于介值定理，若连续函数在区间两端变号 f(a)f(b)<0，取中点 c=(a+b)/2，根据变号区间将搜索范围缩小一半。",
      "latex": "c = \\frac{a+b}{2}, \\quad f(a)f(c) < 0 \\implies b \\leftarrow c",
      "difficulty": 2,
      "teaching_role": "core",
      "keywords": ["二分法", "Bisection", "有根区间", "对分区间"]
    },
    {
      "id": "NA_FIXED_POINT",
      "title": "不动点迭代法 (Fixed-Point Iteration)",
      "type": "algorithm",
      "content": "将方程 f(x)=0 变换为等价形式 x = g(x)，构造迭代序列 x_{k+1} = g(x_k)。当 g(x) 满足压缩映射条件时迭代收敛。",
      "latex": "x_{k+1} = g(x_k)",
      "difficulty": 3,
      "teaching_role": "core",
      "keywords": ["不动点迭代", "Fixed Point", "迭代函数", "压缩映射"]
    },
    {
      "id": "NA_NEWTON",
      "title": "牛顿迭代法 (Newton-Raphson Method)",
      "type": "algorithm",
      "content": "利用函数的一阶泰勒展开进行局部线性化，切线与 x 轴交点作为新的近似值。对于单根具有局部二阶收敛性。",
      "latex": "x_{k+1} = x_k - \\frac{f(x_k)}{f'(x_k)}",
      "difficulty": 3,
      "teaching_role": "core",
      "keywords": ["牛顿法", "Newton", "切线法", "线性化", "二次收敛"]
    },
    {
      "id": "NA_LOCAL_CONVERGENCE",
      "title": "局部收敛性 (Local Convergence)",
      "type": "theorem",
      "content": "若初值 x_0 选在真根 x* 的充分小邻域内，迭代序列收敛到 x*。局部收敛性不保证任意较远的初值均能收敛。",
      "latex": "\\lim_{k \\to \\infty} x_k = x^* \\quad \\text{for } x_0 \\in U(x^*, \\delta)",
      "difficulty": 3,
      "teaching_role": "core",
      "keywords": ["局部收敛", "初值邻域", "收敛半径"]
    },
    {
      "id": "NA_CONVERGENCE_ORDER",
      "title": "收敛阶 (Order of Convergence)",
      "type": "definition",
      "content": "衡量迭代误差衰减速率的量。若极限 lim |e_{k+1}| / |e_k|^p = C > 0 (C<1 若 p=1)，称该迭代法具有 p 阶收敛性。",
      "latex": "\\lim_{k \\to \\infty} \\frac{|e_{k+1}|}{|e_k|^p} = C",
      "difficulty": 4,
      "teaching_role": "core",
      "keywords": ["收敛阶", "一阶收敛", "二阶收敛", "渐进误差常数"]
    },
    {
      "id": "NA_STOPPING_CRITERIA",
      "title": "停机准则 (Stopping Criteria)",
      "type": "concept",
      "content": "迭代终止的科学判据。通常联合考察绝对/相对步长 |x_{k+1}-x_k|、残差 |f(x_k)| 以及最大迭代次数上限以防死循环。",
      "latex": "|x_{k+1}-x_k| < \\varepsilon_x \\quad \\text{and} \\quad |f(x_{k+1})| < \\varepsilon_f",
      "difficulty": 2,
      "teaching_role": "core",
      "keywords": ["停机准则", "步长判据", "残差判据", "最大迭代次数"]
    },
    {
      "id": "NA_RESIDUAL",
      "title": "残差 (Residual)",
      "type": "definition",
      "content": "近似值代入原方程所得的偏差量 r_k = f(x_k)。残差小并不等价于误差小，特别是在函数导数极平缓或病态的情况下。",
      "latex": "r_k = f(x_k)",
      "difficulty": 2,
      "teaching_role": "core",
      "keywords": ["残差", "Residual", "函数值偏差"]
    },
    {
      "id": "NA_APPROX_ERROR",
      "title": "近似误差 (Approximation Error)",
      "type": "definition",
      "content": "近似值与未知真根之间的真实距离 e_k = x_k - x*。在实际计算中真根未知，需通过误差界或后验估计来控制。",
      "latex": "e_k = x_k - x^*",
      "difficulty": 2,
      "teaching_role": "core",
      "keywords": ["近似误差", "真实误差", "误差界"]
    },
    {
      "id": "NA_CONTRACTION_MAPPING",
      "title": "压缩映射定理 (Contraction Mapping)",
      "type": "theorem",
      "content": "若映射 g(x) 在闭区间 [a,b] 上满足 |g'(x)| <= L < 1 且 g([a,b]) 包含于 [a,b]，则 g 在该区间存在唯一不动点且不动点迭代必收敛。",
      "latex": "|g'(x)| \\le L < 1",
      "difficulty": 4,
      "teaching_role": "core",
      "keywords": ["压缩映射", "利普希茨条件", "收敛充分条件"]
    },
    {
      "id": "NA_NEWTON_UPDATE",
      "title": "牛顿迭代步公式",
      "type": "definition",
      "content": "牛顿迭代法单步更新量为 -f(x_k)/f'(x_k)。在编程实现时须检查分母 f'(x_k) 是否接近浮点零以防数值溢出。",
      "latex": "\\Delta x_k = -\\frac{f(x_k)}{f'(x_k)}",
      "difficulty": 2,
      "teaching_role": "core",
      "keywords": ["牛顿步", "更新量", "导数除法"]
    },
    {
      "id": "NA_BRACKET_INVARIANT",
      "title": "区间包围不变性 (Bracket Invariant)",
      "type": "concept",
      "content": "二分法每一步都维护不变式：当前区间 [a_k, b_k] 满足 f(a_k)f(b_k) <= 0 且长度折半，保证根永远被安全锁定在区间内。",
      "latex": "f(a_k)f(b_k) \\le 0, \\quad b_k - a_k = \\frac{b_0 - a_0}{2^k}",
      "difficulty": 2,
      "teaching_role": "core",
      "keywords": ["区间包围", "不变式", "折半保证"]
    },
    {
      "id": "NA_ITERATION_TRACE",
      "title": "迭代轨迹与收敛表 (Iteration Trace)",
      "type": "concept",
      "content": "记录每次迭代的步数 k、当前解 x_k、更新步长 |x_k - x_{k-1}| 以及残差 |f(x_k)|，用以分析数值算法的收敛行为。",
      "latex": "\\{(k, x_k, |x_k - x_{k-1}|, |f(x_k)|)\\}",
      "difficulty": 2,
      "teaching_role": "core",
      "keywords": ["迭代轨迹", "收敛历史", "数值记录"]
    },
    {
      "id": "MATH_CONTINUITY",
      "title": "连续性 (Continuity)",
      "type": "concept",
      "content": "函数在定义域内极限等于函数值。连续性是介值定理与泰勒展开适用的基石。",
      "latex": "\\lim_{x \\to x_0} f(x) = f(x_0)",
      "difficulty": 1,
      "teaching_role": "auxiliary",
      "keywords": ["连续性", "极限", "微积分基础"]
    },
    {
      "id": "MATH_IVT",
      "title": "介值定理 / 零点定理 (Intermediate Value Theorem)",
      "type": "theorem",
      "content": "连续函数在区间两端异号 f(a)f(b)<0 则在开区间 (a,b) 内至少存在一点 c 使得 f(c)=0。此为二分法的理论基础。",
      "latex": "f(a)f(b) < 0 \\implies \\exists c \\in (a,b), \\; f(c)=0",
      "difficulty": 1,
      "teaching_role": "auxiliary",
      "keywords": ["介值定理", "零点定理", "端点异号"]
    },
    {
      "id": "MATH_DERIVATIVE",
      "title": "导数与切线斜率 (Derivative)",
      "type": "definition",
      "content": "函数在某点的瞬时变化率，几何上对应切线的斜率。牛顿法即利用导数构造切线交点。",
      "latex": "f'(x) = \\lim_{h \\to 0} \\frac{f(x+h)-f(x)}{h}",
      "difficulty": 1,
      "teaching_role": "auxiliary",
      "keywords": ["导数", "切线斜率", "一阶微分"]
    },
    {
      "id": "MATH_TAYLOR",
      "title": "泰勒展开公式 (Taylor Expansion)",
      "type": "theorem",
      "content": "在单点展开的一阶泰勒多项式与拉格朗日余项是牛顿法构造和二阶收敛性证明的核心工具。",
      "latex": "f(x) = f(x_0) + f'(x_0)(x-x_0) + \\frac{f''(\\xi)}{2}(x-x_0)^2",
      "difficulty": 2,
      "teaching_role": "auxiliary",
      "keywords": ["泰勒公式", "线性近似", "高阶余项"]
    },
    {
      "id": "MATH_SIMPLE_ROOT",
      "title": "单根 (Simple Root)",
      "type": "definition",
      "content": "满足 f(x*)=0 且 f'(x*) != 0 的根。在单根处，牛顿法满足标准二阶收敛条件。",
      "latex": "f(x^*) = 0 \\quad \\text{and} \\quad f'(x^*) \\neq 0",
      "difficulty": 2,
      "teaching_role": "auxiliary",
      "keywords": ["单根", "导数非零"]
    },
    {
      "id": "MATH_MULTIPLE_ROOT",
      "title": "重根 (Multiple Root)",
      "type": "definition",
      "content": "满足 f(x*)=0 且 f'(x*)=0，...，f^{(m-1)}(x*)=0 但 f^{(m)}(x*)!=0 的 m 重根。重根处牛顿法收敛阶退化为一阶。",
      "latex": "f(x^*) = f'(x^*) = \\cdots = f^{(m-1)}(x^*) = 0, \\; f^{(m)}(x^*) \\neq 0",
      "difficulty": 3,
      "teaching_role": "auxiliary",
      "keywords": ["重根", "多重根", "二阶退化"]
    },
    {
      "id": "NA_COUNTER_NEWTON_CYCLE",
      "title": "反例：牛顿法 0<->1 振荡环",
      "type": "concept",
      "content": "存在特定函数与初值，使得切线交点在两个非零点之间周期性振荡交替（如 x=0 与 x=1 之间循环），导致牛顿法永不收敛到根。",
      "latex": "x_{k+1} = 1 - x_k",
      "difficulty": 3,
      "teaching_role": "extension",
      "keywords": ["振荡环", "周期环", "牛顿反例", "初值陷阱"]
    },
    {
      "id": "NA_COUNTER_RESIDUAL_SMALL_ERROR_LARGE",
      "title": "反例：残差极小但误差极大",
      "type": "concept",
      "content": "当函数图像极其平坦（导数 f'(x) 极其接近 0）时，在距离真根很远的点处残差已小于 1e-6，若仅用残差停机会导致误判收敛。",
      "latex": "|f(x_k)| < 10^{-6} \\quad \\text{but} \\quad |x_k - x^*| > 1.0",
      "difficulty": 3,
      "teaching_role": "extension",
      "keywords": ["残差反例", "平缓函数", "假收敛"]
    },
    {
      "id": "NA_COUNTER_MULTIPLE_ROOT_LINEAR",
      "title": "反例：重根导致牛顿法一阶收敛",
      "type": "concept",
      "content": "对于方程 f(x) = (x-1)^2 = 0，牛顿迭代步为 x_{k+1} = x_k - (x_k-1)/2 = 0.5 x_k + 0.5，其收敛因子为恒定 0.5，二阶收敛失效退化为一阶。",
      "latex": "e_{k+1} = \\frac{1}{2} e_k",
      "difficulty": 3,
      "teaching_role": "extension",
      "keywords": ["重根反例", "退化线性收敛", "收敛降阶"]
    },
    {
      "id": "NA_COUNTER_DISCONTINUOUS_SIGN_CHANGE",
      "title": "反例：跳跃间断点变号伪根",
      "type": "concept",
      "content": "对于函数 f(x)=1/x，在 [-1, 1] 端点异号 f(-1)=-1, f(1)=1，但由于在 x=0 存在跳跃/奇点间断，该区间内不存在任何实根。",
      "latex": "f(-1)f(1) < 0 \\; \\not\\implies \\; \\exists x^*, \\; f(x^*)=0",
      "difficulty": 2,
      "teaching_role": "extension",
      "keywords": ["间断点", "端点异号反例", "连续性必要性"]
    },
    {
      "id": "MISC_RESIDUAL_EQ_ERROR",
      "title": "易错点：误将残差等同于真实误差",
      "type": "concept",
      "content": "学生常误以为只要 |f(x_k)| 很小就代表 x_k 非常接近精确根 x*。忽略了函数斜率极小时残差与误差的巨大偏差。",
      "latex": "|f(x)| < \\varepsilon \\; \\not\\implies \\; |x - x^*| < \\varepsilon",
      "difficulty": 2,
      "teaching_role": "core",
      "keywords": ["残差误区", "误差混淆", "假精确"]
    },
    {
      "id": "MISC_NEWTON_ALWAYS_CONVERGES",
      "title": "易错点：误以为牛顿法对任意初值必收敛",
      "type": "concept",
      "content": "学生常误以为牛顿法收敛速度快就一定能收敛。忽略了其本质是局部收敛算法，初值不当会导致发散、振荡或跑到其他远处的根。",
      "latex": "x_0 \\notin U(x^*, \\delta) \\implies \\text{可能发散}",
      "difficulty": 2,
      "teaching_role": "core",
      "keywords": ["牛顿必收敛误区", "初值忽略", "全局收敛盲区"]
    },
    {
      "id": "MISC_NEWTON_ALWAYS_QUADRATIC",
      "title": "易错点：误以为牛顿法总是二阶收敛",
      "type": "concept",
      "content": "学生常忽略二阶收敛的前提条件是单根（f'(x*) != 0）。在重根处，牛顿法仅具有一阶线性收敛性。",
      "latex": "f'(x^*) = 0 \\implies p=1 \\text{ (而非 2)}",
      "difficulty": 3,
      "teaching_role": "core",
      "keywords": ["二阶必然性误区", "重根条件忽略"]
    },
    {
      "id": "MISC_SIGN_WITHOUT_CONTINUITY",
      "title": "易错点：忽略连续性直接用介值定理",
      "type": "concept",
      "content": "学生在判断是否有根时仅检查 f(a)f(b)<0，未检查 f 在 [a,b] 上是否连续，易在含奇点或分段函数上犯错。",
      "latex": "f(a)f(b) < 0 \\text{ 但 } f \\text{ 不连续}",
      "difficulty": 2,
      "teaching_role": "core",
      "keywords": ["连续性忽略", "介值定理前提误区"]
    }
  ],
