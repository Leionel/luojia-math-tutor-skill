APP_ENV=local
DATABASE_URL=sqlite:///./luojia_tutor.db
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
VISION_MODEL=glm-4.6v-flash
ALLOW_USER_API_KEY=false
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Production authentication. Set a random value of at least 32 characters.
AUTH_REQUIRED=false
AUTH_TOKEN_SECRET=local-development-only-change-before-production
AUTH_TOKEN_TTL_SECONDS=86400

# Learning-policy calibration knobs.
INITIAL_MASTERY=0.5
DEFAULT_DIFFICULTY=3
REMEDIATION_ERROR_THRESHOLD=2
REMEDIATION_MASTERY_THRESHOLD=0.3
HINT_ERROR_LIGHT=1
HINT_ERROR_FORMULA=2
HINT_ERROR_NEAR_ANSWER=3
HINT_MASTERY_FORMULA=0.2
HINT_MASTERY_LIGHT=0.4
BKT_SLIP_PROBABILITY=0.10
BKT_GUESS_INDEPENDENT=0.10
BKT_GUESS_LIGHT_HINT=0.40
BKT_GUESS_HEAVY_HINT=0.80
BKT_LEARN_INDEPENDENT=0.15
BKT_LEARN_LIGHT_HINT=0.05
BKT_LEARN_HEAVY_HINT=0.00
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_WORKER_POLL_SECONDS=1.0

# Offline LuojiaMathBench V9 agents. These must point at the Luna provider,
# not the tutor's normal chat-model configuration.
BENCHMARK_AGENT_BASE_URL=
BENCHMARK_AGENT_API_KEY=
BENCHMARK_AGENT_MODEL=luna-5.6
BENCHMARK_AGENT_REASONING_EFFORT=max
BENCHMARK_AGENT_MAX_TOKENS=0
BENCHMARK_AGENT_TIMEOUT_SECONDS=120
BENCHMARK_AGENT_MAX_RETRIES=1
